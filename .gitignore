# Python Virtual Environments (the node_modules equivalents)
.venv/
venv/
env/
ENV/

# Python compiled bytecode (already visible in your scripts/__pycache__/)
__pycache__/
*.py[cod]
*$py.class

# Environment variables & API keys
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Model weights & Hugging Face local cache
.cache/
huggingface/

# Generated local transcripts & output artifacts
transcripts/*.txt
!transcripts/mock_labeled_mixed.txt

# Ignore all uploaded audio/documents but keep the folder
data/uploads/*
!data/uploads/.gitkeep

# Ignore generated meeting records but keep the folder
data/meetings/*
!data/meetings/.gitkeep

# Ignore root data artifacts
data/*.json
!data/.dedup_registry.json

# Test, coverage, and runtime logs
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.log

# Local databases
*.db
*.sqlite
*.sqlite3

# Frontend build outputs
backend/static/
frontend/dist/

# Node dependencies
node_modules/
frontend/node_modules/

# Vite & build caches
frontend/.vite/
*.local